<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrustedMaster.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrustedMaster.Views"
    Title="TrustedMaster - Elevation Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <NavigationView
            x:Name="MainNavigationView"
            Grid.Column="0"
            Width="320"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" />
                <NavigationViewItem Content="Permissions" Tag="permissions" />
                <NavigationViewItem Content="Settings" Tag="settings" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel>
                    <NavigationViewItem Content="About" />
                </StackPanel>
            </NavigationView.PaneFooter>
        </NavigationView>

        <Frame x:Name="ContentFrame" Grid.Column="1" Padding="12">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <ContentThemeTransition />
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
    </Grid>
</Window>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TrustedMaster</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TrustedMaster.ExplorerCommand\**" />
    <Content Remove="TrustedMaster.ExplorerCommand\**" />
    <None Remove="TrustedMaster.ExplorerCommand\**" />
    <Page Remove="TrustedMaster.ExplorerCommand\**" />
    <ApplicationDefinition Remove="TrustedMaster.ExplorerCommand\**" />
    <EmbeddedResource Remove="TrustedMaster.ExplorerCommand\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <ExplorerCommandRid Condition="'$(Platform)' == 'x86'">win-x86</ExplorerCommandRid>
    <ExplorerCommandRid Condition="'$(Platform)' == 'ARM64'">win-arm64</ExplorerCommandRid>
    <ExplorerCommandRid Condition="'$(ExplorerCommandRid)' == ''">win-x64</ExplorerCommandRid>
    <ExplorerCommandSelfContained>false</ExplorerCommandSelfContained>
  </PropertyGroup>

  <Target Name="PrepareExplorerCommand" BeforeTargets="BeforeBuild">
    <MSBuild
        Projects="$(MSBuildProjectDirectory)\TrustedMaster.ExplorerCommand\TrustedMaster.ExplorerCommand.csproj"
        Targets="Restore;Build"
        Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(ExplorerCommandRid);SelfContained=$(ExplorerCommandSelfContained)"
        RemoveProperties="PublishTrimmed;PublishReadyToRun;PublishSingleFile;PublishProfile;TargetFramework" />

    <ItemGroup>
      <Content Include="$(MSBuildProjectDirectory)\TrustedMaster.ExplorerCommand\bin\$(Configuration)\net8.0-windows\$(ExplorerCommandRid)\TrustedMaster.ExplorerCommand.*">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>

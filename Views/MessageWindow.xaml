<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrustedMaster.Views.MessageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Run as TrustedMaster">

    <Grid Padding="28" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                <FontIcon Glyph="&#xE7BA;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </Border>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top"/>

        <Button Grid.Row="2" Content="Close" MinWidth="96" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="OnCloseClick"/>
    </Grid>
</Window>

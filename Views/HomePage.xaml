<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrustedMaster.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock Text="Home" FontSize="28" FontWeight="SemiBold"/>

            <TextBlock Text="Run any application as TrustedInstaller, SYSTEM, or another identity." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                <StackPanel Spacing="12">
                    <TextBlock Text="System Information" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Activation" Opacity="0.7"/>
                        <TextBlock x:Name="ActivationValueText" Grid.Column="1" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="1" Text="System" Opacity="0.7"/>
                        <TextBlock x:Name="SystemNameValueText" Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="2" Text="Version" Opacity="0.7"/>
                        <TextBlock x:Name="SystemVersionValueText" Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="3" Text="Device" Opacity="0.7"/>
                        <TextBlock x:Name="DeviceModelValueText" Grid.Row="3" Grid.Column="1" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="4" Text="CPU" Opacity="0.7"/>
                        <TextBlock x:Name="CpuValueText" Grid.Row="4" Grid.Column="1" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="5" Text="RAM" Opacity="0.7"/>
                        <TextBlock x:Name="RamValueText" Grid.Row="5" Grid.Column="1" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="6" Text="Storage" Opacity="0.7"/>
                        <TextBlock x:Name="StorageValueText" Grid.Row="6" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                <StackPanel Spacing="16">
                    <TextBlock Text="Mode Settings" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="User:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="UserModeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="TrustedInstaller" Tag="TrustedInstaller"/>
                            <ComboBoxItem Content="SYSTEM" Tag="System"/>
                            <ComboBoxItem Content="Current User" Tag="CurrentUser"/>
                            <ComboBoxItem Content="Current Process" Tag="CurrentProcess"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="EnableAllPrivilegesCheckBox" Content="Enable All Privileges"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Open:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ApplicationComboBox" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True" PlaceholderText="Select or type an application path"/>
                    <Button Grid.Column="2" Content="Browse" MinWidth="96" Click="OnBrowseClick"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="RunButton" Content="Run" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Click="OnRunClick"/>
                <ProgressRing x:Name="RunProgressRing" Width="20" Height="20" IsActive="False" VerticalAlignment="Center"/>
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>

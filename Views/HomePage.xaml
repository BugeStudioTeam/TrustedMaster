<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrustedMaster.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="32" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Mode Settings" FontSize="14" Opacity="0.8"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="User:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="UserModeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="TrustedInstaller" Tag="TrustedInstaller"/>
                            <ComboBoxItem Content="SYSTEM" Tag="System"/>
                            <ComboBoxItem Content="Current User" Tag="CurrentUser"/>
                            <ComboBoxItem Content="Current Process" Tag="CurrentProcess"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="EnableAllPrivilegesCheckBox" Content="Enable All Privileges"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Open:" VerticalAlignment="Center"/>
                <ComboBox x:Name="ApplicationComboBox" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True" PlaceholderText="Select or type an application path"/>
                <Button Grid.Column="2" Content="Browse" MinWidth="96" Click="OnBrowseClick"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                <Button x:Name="RunButton" Content="Run" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Click="OnRunClick"/>
                <ProgressRing x:Name="RunProgressRing" Width="20" Height="20" IsActive="False" VerticalAlignment="Center"/>
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar" Grid.Row="3" IsOpen="False" IsClosable="True"/>
        </Grid>
    </ScrollViewer>
</Page>

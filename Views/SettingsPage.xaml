<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrustedMaster.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>

            <TextBlock Text="Defaults applied when TrustedMaster starts." Opacity="0.7" TextWrapping="Wrap"/>

            <ComboBox x:Name="DefaultUserModeComboBox" Header="Default user mode" MinWidth="260" HorizontalAlignment="Left">
                <ComboBoxItem Content="TrustedInstaller" Tag="TrustedInstaller"/>
                <ComboBoxItem Content="SYSTEM" Tag="System"/>
                <ComboBoxItem Content="Current User" Tag="CurrentUser"/>
                <ComboBoxItem Content="Current Process" Tag="CurrentProcess"/>
            </ComboBox>

            <ToggleSwitch x:Name="EnableAllPrivilegesToggle" Header="Enable all privileges by default" OnContent="On" OffContent="Off"/>

            <TextBlock x:Name="AuthorizedCountText" Opacity="0.7"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick"/>
                <Button Content="Clear authorized applications" Click="OnClearAuthorizedClick"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>

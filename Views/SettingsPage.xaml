<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrustedMaster.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="8" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Text="Defaults applied when TrustedMaster starts." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Default user mode" FontWeight="SemiBold"/>
                        <TextBlock Text="User identity used when launching applications by default." Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>

                    <ComboBox x:Name="DefaultUserModeComboBox" Grid.Column="1" MinWidth="180" VerticalAlignment="Center" SelectionChanged="OnDefaultUserModeChanged">
                        <ComboBoxItem Content="TrustedInstaller" Tag="TrustedInstaller"/>
                        <ComboBoxItem Content="SYSTEM" Tag="System"/>
                        <ComboBoxItem Content="Current User" Tag="CurrentUser"/>
                        <ComboBoxItem Content="Current Process" Tag="CurrentProcess"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Enable all privileges by default" FontWeight="SemiBold"/>
                        <TextBlock Text="Enable every available privilege on the launched application token." Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="EnableAllPrivilegesToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="On" OffContent="Off" Toggled="OnEnableAllPrivilegesToggled"/>
                </Grid>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Run as TrustedMaster context menu" FontWeight="SemiBold"/>
                        <TextBlock Text="Add a File Explorer context menu entry for running applications with TrustedMaster." Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="ContextMenuToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="On" OffContent="Off" Toggled="OnContextMenuToggled"/>
                </Grid>
            </Border>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Authorized applications" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AuthorizedCountText" Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Clear authorized applications" VerticalAlignment="Center" Click="OnClearAuthorizedClick"/>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
